# Network settings
HOST=0.0.0.0
PORT=8443
HTTPS_ENABLED=true

# Security (Leave commented out or empty to disable authentication)
# WEBHOOK_SECRET=your_super_secret_token_here

# TLS Certificates (Automatically generated self-signed by default).
# Paths default to certs/ and data/ inside the project folder; set them to override.
# SSL_CERTFILE=/path/to/sms_webhook/certs/cert.pem
# SSL_KEYFILE=/path/to/sms_webhook/certs/key.pem
AUTO_GENERATE_CERT=true

# SQLite Database
# DB_PATH=/path/to/sms_webhook/data/webhooks.db

# GnuCash-web integration (optional). Both must be set to enable posting.
# GNUCASH_URL=http://192.168.1.10:8097
# GNUCASH_API_TOKEN=gcw_...
# Label shown when nothing suggests a To account (never created in gnucash-web).
# GNUCASH_UNCATEGORISED_LABEL=Uncategorised
